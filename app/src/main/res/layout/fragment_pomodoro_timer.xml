<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="24dp">

    <!-- 뒤로가기 버튼 -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="뒤로가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#AAAAAA" />

    <!-- 과목 이름 -->
    <TextView
        android:id="@+id/tv_subject_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="모바일 프로그래밍"
        android:textColor="#8B5CF6"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 원형 타이머 뷰 -->
    <edu.sswu.vitaday.ui.timer.CircularTimerView
        android:id="@+id/circular_timer_view"
        android:layout_width="320dp"
        android:layout_height="320dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subject_name"
        app:layout_constraintBottom_toTopOf="@id/ll_control_buttons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp" />

    <!-- 컨트롤 버튼들 -->
    <LinearLayout
        android:id="@+id/ll_control_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 시작 버튼 -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="시작"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:layout_marginEnd="8dp" />

        <!-- 일시정지 버튼 -->
        <Button
            android:id="@+id/btn_pause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="일시정지"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#FF9800"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- 정지 버튼 -->
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="정지"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#CC3333"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- 리셋 버튼 -->
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="리셋"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#666666"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
